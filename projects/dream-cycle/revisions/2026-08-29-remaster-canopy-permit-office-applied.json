  "proposal": {
    "title": "Boundary Day",
    "idea": "The forest's border only counts where someone has walked it this year, so once every spring a dryad bush pilot flies the whole line herself — and this spring an orbital company has parked its claim beacons inside it.",
    "vibe": {
      "title": "Boundary Day",
      "line": "Out here the border is a line you have to go and walk yourself.",
      "art_direction": "A battered floatplane low over an unbroken green canopy at dawn, a corridor of black-boned white trees cutting through the green from horizon to horizon, orbital contrails scratched across a pale sky."
    },
    "locations": [
      {
        "title": "The Bonewood Line",
        "known_for": "a corridor of black-boned trees no survey from orbit can see through",
        "local_rule": "the border is wherever it was last walked, not wherever it was last drawn",
        "best_scene": "a company skiff crosses the corridor and the trees close in behind it",
        "art_direction": "A narrow avenue cut through dense jungle by pale trunks veined in glossy black bone, low mist between them, sunlight coming down in hard vertical bars, wet leaf litter churned by something heavy."
      }
    ],
    "characters": [
      {
        "name": "Kesia Adeyemi",
        "role_drive": "fly the whole border in one day so it still counts when the company lawyers arrive",
        "carries": "a strap of green cuttings taken from her own arm to graft where the line has died back",
        "complication": "every graft she cuts for the border comes out of her, and the border is long",
        "look": "A wiry dryad pilot in an oil-stained flight suit, bark-grey skin split with fresh green at the elbows, leaf-dark hair bound in a scarf, one forearm bandaged where cuttings were taken."
      }
    ],
    "rewards": [
      {
        "name": "The Claim Splinter",
        "reward_type": "ITEM",
        "rarity": "RARE",
        "grants": "makes a border real enough to stop a machine for one day",
        "best_used_when": "something expensive is already moving across the line",
        "catch": "it only holds for a day, and it must be driven in by hand",
        "look": "A black splinter of demonic bone the length of a hand, glassy and slightly warm, its broad end burred over from being hammered into hard ground."
      },
      {
        "name": "Rootwake Landing",
        "reward_type": "SKILL",
        "rarity": "UNCOMMON",
        "grants": "asks the canopy to open a gap big enough to land in",
        "best_used_when": "there is nowhere flat for a hundred kilometres",
        "catch": "the canopy decides the size of the gap, and it is never generous",
        "look": "Branches drawing back from a descending hull in a slow spiral, leaf litter blasting outward in a widening ring, green light flaring where the wood parts."
      }
    ],
    "scenarios": [
      {
        "title": "The Line They Flew Twice",
        "setup": "In Boundary Day, along The Bonewood Line, Kesia Adeyemi races the sunset around the whole border while a company survey skiff flies the same line the other way, both of them trying to be the last one to have walked it."
      }
    ],
