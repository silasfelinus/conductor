  "proposal": {
    "title": "The Island That Started Swimming",
    "idea": "A village lashed to the barnacled back of a sleeping manatee-god wakes to find the god moving, and the newest arrival — a transfer student who cannot hold her breath a full minute — has to cut the houses free before it sounds.",
    "vibe": {
      "title": "The Island That Started Swimming",
      "line": "The kindest god in the sea is still a god, and it is leaving.",
      "art_direction": "An immense barnacled grey back breaching under a village of stilt houses, gold starfruit-fiber cables snapping taut against a green-black horizon, spray hanging in the air like smoke."
    },
    "locations": [
      {
        "title": "Halewater Spine",
        "known_for": "a whole village lashed to the back of a living god",
        "local_rule": "cut your house loose before the dive, never during",
        "best_scene": "the deck tilts as the god rolls and every cable in the village sings one note",
        "art_direction": "Stilt houses of bleached plank standing on a vast barnacled hide, gold fiber cable strung between them over shallow tide pools, shrine buoys of carved shell knocking together in green light."
      }
    ],
    "characters": [
      {
        "name": "Ines Abarca",
        "role_drive": "cut the last houses free before the god sounds",
        "carries": "a chalk float-board covered edge to edge in letters she has never sent home",
        "complication": "she transferred in from a dry inland school and cannot hold her breath a minute",
        "look": "A short, sun-scorched student in a borrowed oilskin two sizes too big, chalk dust white on her forearms, a cracked slate board roped across her back and a shell knife at her hip."
      }
    ],
    "rewards": [
      {
        "name": "The Sounding Cord",
        "reward_type": "ITEM",
        "rarity": "RARE",
        "grants": "goes taut a few seconds before the god dives",
        "best_used_when": "nobody can agree whether there is still time",
        "catch": "it only warns the hand actually holding it",
        "look": "A coil of pale gold starfruit-fiber rope stiff with dried salt, flecked green where it has lain against hide, its free end weighted with a fist of grey sea glass."
      },
      {
        "name": "Borrowed Breath",
        "reward_type": "SKILL",
        "rarity": "UNCOMMON",
        "grants": "lets one diver spend a breath another diver is holding",
        "best_used_when": "someone younger is still down there",
        "catch": "the lender surfaces gasping and cannot lend again that day",
        "look": "Two silver bubble trails crossing in dark water, one thinning to nothing as the other swells and rushes upward."
      }
    ],
    "scenarios": [
      {
        "title": "The First Sounding",
        "setup": "On Halewater Spine, as The Island That Started Swimming turns for open water, Ines Abarca runs the tilting deck cutting stilt houses loose one cable at a time while the shrine buoys go under and the god's back slides beneath the waterline."
      }
    ],
