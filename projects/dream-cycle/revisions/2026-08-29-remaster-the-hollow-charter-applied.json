  "proposal": {
    "title": "The Ironback Braid",
    "idea": "Two lineages tied their old agreement into a braided rope and sealed it inside the carcass of a dead terraforming leviathan. The hull engineer whose plated hands finally open that chamber walks straight into both of their claims at once.",
    "vibe": {
      "title": "The Ironback Braid",
      "line": "Two lineages tied their agreement into a rope, and nobody alive can read a knot.",
      "art_direction": "A colossal rusted ribcage interior lit by flat blue emergency light, a thick braided rope of black grained wood and hull wire strung across a chamber, banded iron plates unrolling like a shell."
    },
    "locations": [
      {
        "title": "The Ironback Hulk",
        "known_for": "the gutted carcass of a kilometre-long terraforming leviathan, still sealed at its core",
        "local_rule": "the plates only unroll for a hand they have felt before",
        "best_scene": "the banded door unrolls scute by scute while gas hisses from vents shaped like gills",
        "art_direction": "A cavernous curved hull interior ribbed like a colossal rusted spine, brass conduit veins along riveted iron plates, an armadillo-banded door of overlapping scutes unrolling at the far end under flat blue light."
      }
    ],
    "characters": [
      {
        "name": "Halden R. Boone",
        "role_drive": "get the chamber open without becoming the person who has to decide who owns it",
        "carries": "a wrist-mounted breach kit of magnetised picks on a short lanyard",
        "complication": "he is entirely confident he can hand this off to somebody senior, and there is nobody senior",
        "look": "Overlapping armadillo-banded grey-brown dermal scutes running down both forearms and across the knuckles, a cropped patchwork jacket with the sleeves cut away, breach kit strapped at one wrist."
      }
    ],
    "rewards": [
      {
        "name": "The Shadow Oak Spindle",
        "reward_type": "ITEM",
        "rarity": "RARE",
        "grants": "unwinds exactly one turn of a braid at a time and holds it there",
        "best_used_when": "everyone in the room wants the whole thing opened at once",
        "catch": "one turn per person present, and it counts everyone",
        "look": "A hand-length spindle turned from shadow-oak so dark it takes no highlight, its shaft polished by handling, a single strand of hull wire caught in the groove."
      },
      {
        "name": "The Third Cup",
        "reward_type": "SKILL",
        "rarity": "UNCOMMON",
        "grants": "buys one round of calm between people who arrived armed",
        "best_used_when": "both sides are still standing and neither has sat down",
        "catch": "it lasts exactly as long as the tea does",
        "look": "Steam rising in three straight columns from small cups on a low table, none of it drifting sideways however the air moves."
      }
    ],
    "scenarios": [
      {
        "title": "Two Delegations, One Knot",
        "setup": "In The Ironback Braid, deep inside The Ironback Hulk, Halden R. Boone unrolls the last banded plate and finds two delegations already seated on either side of the braid, each waiting for him to hand it to them."
      }
    ],
