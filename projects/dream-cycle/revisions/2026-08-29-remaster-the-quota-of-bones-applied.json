  "proposal": {
    "title": "The Salt Rebellion",
    "idea": "A centaur field cook feeds a mining camp whose ore rewrites the bodies of anyone it touches, and when the season's salt runs out she leads the camp uphill against the company that owns the road.",
    "vibe": {
      "title": "The Salt Rebellion",
      "line": "Feed people well enough and eventually they stand up.",
      "art_direction": "A canvas field kitchen on a scree slope at dusk, enormous copper pots steaming, raw astral ore glowing faint blue in a barrow nearby, long shadows of a crowd gathering beyond the firelight."
    },
    "locations": [
      {
        "title": "Sixmile Camp",
        "known_for": "the one hot meal between the ore face and the valley road",
        "local_rule": "everyone eats before anyone eats twice",
        "best_scene": "four hundred people set down their bowls at the same moment and start walking uphill",
        "art_direction": "A sprawl of guyed canvas tents on grey scree, trestle tables slick with rain, steam rolling off copper cauldrons, blue-glowing ore chips trodden into the mud, storm light behind the ridge."
      }
    ],
    "characters": [
      {
        "name": "Ilse Vantroost",
        "role_drive": "keep four hundred miners fed well enough to hold the road for one more night",
        "carries": "a ladle the length of an arm and the camp's last two blocks of grey salt",
        "complication": "the ore has begun rewriting her hind legs, and she has told no one",
        "look": "A broad chestnut centaur in a scorched leather apron, forearms burn-marked to the elbow, greying hair bound up under a knotted cloth, one hind fetlock gone glassy blue and wrapped in sacking."
      }
    ],
    "rewards": [
      {
        "name": "The Last Grey Block",
        "reward_type": "ITEM",
        "rarity": "RARE",
        "grants": "makes any food, however poor, worth sitting down for",
        "best_used_when": "people are too tired to keep arguing on empty stomachs",
        "catch": "it is finite, visibly, and everyone can see how much is left",
        "look": "A coarse block of grey rock salt the size of two fists, one face worn into a smooth hollow by the grater, faint blue veins running through the crystal."
      },
      {
        "name": "The Fair Share",
        "reward_type": "SKILL",
        "rarity": "UNCOMMON",
        "grants": "divides anything among a crowd so that nobody feels cheated",
        "best_used_when": "there is not enough and everyone knows it",
        "catch": "the divider's own portion is what gets made smaller",
        "look": "A ladle pouring in an unbroken arc down a line of held-out bowls, each filling to exactly the same height, steam rising in one continuous ribbon."
      }
    ],
    "scenarios": [
      {
        "title": "The Night the Bowls Went Down",
        "setup": "In The Salt Rebellion, at Sixmile Camp, Ilse Vantroost serves the last hot meal before the company closes the valley road, and when the bowls come down she is the one at the front of four hundred people walking up it."
      }
    ],
