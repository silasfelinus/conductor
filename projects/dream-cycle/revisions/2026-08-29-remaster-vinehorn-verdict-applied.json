  "proposal": {
    "title": "The Noon Mirrors",
    "idea": "A hill city aims ten thousand hand-set mirrors at its orchards every dawn. Someone re-aimed them in the night, and the only person who can cross the field at noon to prove it is a revenant who has already died once out there.",
    "vibe": {
      "title": "The Noon Mirrors",
      "line": "Aim the light wrong and the city eats an orchard.",
      "art_direction": "Thousands of hand-set mirrors stepping down a terraced hillside, converging white beams igniting a single fig tree, heat shimmer bending the horizon, speckled violet granite underfoot."
    },
    "locations": [
      {
        "title": "Halcyon Mirrorfield",
        "known_for": "ten thousand mirrors aimed by hand before sunrise",
        "local_rule": "nobody crosses the field between the eleventh and first bell",
        "best_scene": "the beams converge and a fig tree lights like a struck match",
        "art_direction": "Terraced rows of tarnished hand-set mirrors on violet granite scree, brass aiming cranks green with verdigris, one scorched black circle burned into the slope, white light too bright to look at."
      }
    ],
    "characters": [
      {
        "name": "Dolan Ferreira",
        "role_drive": "find who re-aimed the mirrors before the next dawn burn",
        "carries": "a folded leather hood and two spare hands wrapped in oilcloth",
        "complication": "he burns and does not heal, so every hour in the field costs him another piece",
        "look": "A heavy-shouldered minotaur in a scorched canvas apron, one horn capped in beaten copper, hide cracked and seamed with old burn scar, coarse stitches holding his left forearm to the wrist."
      }
    ],
    "rewards": [
      {
        "name": "The Dawnpin",
        "reward_type": "ITEM",
        "rarity": "RARE",
        "grants": "locks any hinge, joint, or mirror exactly where it stands",
        "best_used_when": "something must not move again before witnesses arrive",
        "catch": "whatever it locks, it locks until the pin is drawn by the hand that set it",
        "look": "A hand-forged pin of speckled violet granite the length of a finger, its head hammered flat and starred with mica, warm to the touch even in shade."
      },
      {
        "name": "Reading the Burn",
        "reward_type": "SKILL",
        "rarity": "UNCOMMON",
        "grants": "tells the hour a scorch was made from the colour at its edge",
        "best_used_when": "everyone agrees on what happened but not when",
        "catch": "old burns on the reader's own hide answer first, and loudly",
        "look": "Pale blue gaslight glyphs surfacing along a charred rail, brightening to white at one point on the line and dimming away from it."
      }
    ],
    "scenarios": [
      {
        "title": "Before the Next Dawn Burn",
        "setup": "In The Noon Mirrors, out on Halcyon Mirrorfield at the height of the day, Dolan Ferreira walks the burning rows locking crank after crank with the Dawnpin while the council argues below and the light steps steadily toward the orchard that feeds the hill."
      }
    ],
