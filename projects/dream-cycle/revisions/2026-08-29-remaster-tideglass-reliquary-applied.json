  "proposal": {
    "title": "Spawning Tide",
    "idea": "Once a year the horseshoe crabs come ashore in their millions, and the drowned come up with them. The woman hired to walk an old lord across the flats that night has not been told which of the two he intends to end up as.",
    "vibe": {
      "title": "Spawning Tide",
      "line": "Once a year the sea gives everything back at once.",
      "art_direction": "A moonlit tidal flat carpeted edge to edge with armoured horseshoe crabs, a granite causeway running out into black water, pale figures standing further out than anyone should be able to stand."
    },
    "locations": [
      {
        "title": "The Weeping Causeway",
        "known_for": "letters wedged into every joint of its stone by people who could not say it aloud",
        "local_rule": "read one aloud before you cross, whichever one your hand finds",
        "best_scene": "the tide comes over and takes a whole year of letters at once",
        "art_direction": "A low causeway of speckled violet granite running into dark water, folded paper jammed into every seam and fluttering, salt crust and weed on the stones, a drowned graveyard island at the far end under moonlight."
      }
    ],
    "characters": [
      {
        "name": "Juno Ashcombe",
        "role_drive": "walk her client out to the island and back before the tide closes the causeway",
        "carries": "a surveyor's tape, a hooded lamp, and a client's letter she has not opened",
        "complication": "she takes the job at face value, and nobody in the town will explain it to her",
        "look": "A young woman in a waxed storm coat too thin for the season, wet hair scraped back, a brass surveyor's tape clipped at her belt, mud to the knee, a hooded lamp swinging low."
      }
    ],
    "rewards": [
      {
        "name": "The Wrong-Door Stone",
        "reward_type": "ITEM",
        "rarity": "RARE",
        "grants": "opens the door you needed instead of the one in front of you",
        "best_used_when": "the way out is not where you are standing",
        "catch": "it never opens the same door twice, and never opens back",
        "look": "A palm-sized wedge of violet granite worn smooth on one face, a keyhole-shaped void bored clean through it, cold and faintly wet to the touch."
      },
      {
        "name": "Loss Adjustment",
        "reward_type": "SKILL",
        "rarity": "UNCOMMON",
        "grants": "prices exactly what a loss is going to cost the person carrying it",
        "best_used_when": "someone insists they are fine",
        "catch": "the number is always right and never welcome",
        "look": "Thin amber survey lines crawling across wet sand and closing into a tight contour ring around one standing figure."
      }
    ],
    "scenarios": [
      {
        "title": "The Night the Crabs Came Up",
        "setup": "In Spawning Tide, out on The Weeping Causeway during the spawning, Juno Ashcombe walks her client toward the drowning graveyard through a moving carpet of shells, and realises the pale figures standing in the shallows are all facing the two of them."
      }
    ],
