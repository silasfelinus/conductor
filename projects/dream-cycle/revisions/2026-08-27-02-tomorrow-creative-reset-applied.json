    "title": "The Moonpool Matinee",
    "slug": "the-moonpool-matinee",
    "idea": "At midnight, an abandoned boarding-school auditorium performs a different era every time the curtain rises. Student playwright June Bellamy discovers tonight's audience is trapped inside the production, and every improvised line she speaks becomes physically true for thirty seconds.",
    "vibe": {
      "title": "Opening Night Has No Year",
      "line": "Every curtain call opens onto the wrong century.",
      "art_direction": "An empty school stage under blue house lights, red velvet curtains opening onto several incompatible eras at once while a broad dugong silhouette stands at center stage holding a tiny recorder."
    },
    "locations": [
      {
        "title": "The Living Auditorium",
        "known_for": "sets that molt into other eras in the middle of a scene",
        "local_rule": "never applaud after the house lights turn blue",
        "best_scene": "the crystal footlights crack and the stage floor becomes black seawater",
        "art_direction": "A decaying boarding-school auditorium grown through with pale biological ribs and rootlike tubing, jagged amber spire-crystal footlights along the stage, velvet curtains hanging like deep-sea fins."
      }
    ],
    "characters": [
      {
        "name": "June Bellamy",
        "role_drive": "finish the missing final act and get the stranded audience back to its own time before sunrise",
        "carries": "a battered microcassette recorder and a wooden rehearsal sword that becomes real steel beneath the footlights",
        "complication": "every sentence she improvises becomes physically true for thirty seconds, including mistakes",
        "look": "A broad slate-gray dugong student playwright with a whiskered muzzle and small dark eyes, wearing a school cardigan tailored around powerful flipper-like forearms, a microcassette recorder hanging from a canvas strap."
      }
    ],
    "rewards": [
      {
        "name": "The Wolfglass Mask",
        "reward_type": "ITEM",
        "rarity": "RARE",
        "grants": "swaps one role in the current scene between two people",
        "best_used_when": "the wrong person has been cast as the monster or the hero",
        "catch": "the wearer keeps one borrowed trait until sunrise",
        "look": "A half-mask chipped from translucent spire crystal in the shape of a storybook wolf, with one pointed ear broken off and warm amber fractures glowing through its snout."
