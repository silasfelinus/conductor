  "proposal": {
    "title": "The Reactor Dragon",
    "idea": "Everything that keeps a frontier station warm is asleep, armed, and coiled around the reactor — and the analyst who just sold its targeting codes to the wrong buyer has one shift to wake it politely.",
    "vibe": {
      "title": "The Reactor Dragon",
      "line": "Everything keeping this station warm is asleep and still armed.",
      "art_direction": "An enormous scaled body coiled around a glowing reactor housing in a decommissioned docking bay, pink and cyan strip-light washing over dull plating, frost on the deck between the coils."
    },
    "locations": [
      {
        "title": "Neon Bay Nine",
        "known_for": "the only bay warm enough to sleep in, because of what sleeps in it",
        "local_rule": "walk the painted line and do not run, whatever you hear",
        "best_scene": "the coils shift a metre and every strip-light in the bay flickers pink",
        "art_direction": "A cavernous decommissioned docking bay lit in failing magenta and cyan strips, drifts of pale blue mineral dust banked in the corners, painted deck lines curving around something vast and scaled."
      }
    ],
    "characters": [
      {
        "name": "Marisol Quintero",
        "role_drive": "get the sold codes back before the strike window opens",
        "carries": "a analyst's slate with three days of targeting solutions she cannot explain",
        "complication": "she believed the buyer, and she will probably believe the next one too",
        "look": "A young woman in a station-issue jumpsuit with the sleeves cut off, cropped bleached hair, a cracked slate strapped to one forearm, blue mineral dust ground into her knees."
      }
    ],
    "rewards": [
      {
        "name": "The Cold Ping",
        "reward_type": "ITEM",
        "rarity": "RARE",
        "grants": "warns you three seconds before something locks on",
        "best_used_when": "you have chosen to stand somewhere you should not",
        "catch": "three seconds is exactly as long as it sounds",
        "look": "A shard of pale blue angelite set in a cracked steel bezel, its surface fogging over with frost and clearing again in a slow pulse."
      },
      {
        "name": "Talk the Sky Down",
        "reward_type": "SKILL",
        "rarity": "UNCOMMON",
        "grants": "makes an automated system ask permission before it fires",
        "best_used_when": "the decision has already been handed to a machine",
        "catch": "it asks whoever is nearest, and takes their answer",
        "look": "Targeting reticles blooming red across a wide window and unfolding one by one into open rings, the red draining out of them as they widen."
      }
    ],
    "scenarios": [
      {
        "title": "Three Seconds of Warning",
        "setup": "In The Reactor Dragon, down in Neon Bay Nine with the strike window open, Marisol Quintero walks the painted line toward the coils with her slate held out, trying to give the codes back to the only thing on the station that can refuse them."
      }
