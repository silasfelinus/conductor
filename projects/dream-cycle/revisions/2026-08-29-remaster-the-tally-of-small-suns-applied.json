  "proposal": {
    "title": "The Silk Bargain",
    "idea": "After the invasion stalled, two species share one wrecked warship, and peace holds because every promise between them is woven into a sash worn where everyone can see whether it is still being kept.",
    "vibe": {
      "title": "The Silk Bargain",
      "line": "Peace here is a promise you have to wear in public.",
      "art_direction": "A vast wrecked hull opened to the sky and filled with hanging woven sashes glowing faint gold, two very different silhouettes standing close under them, dusk light through torn plating."
    },
    "locations": [
      {
        "title": "The Wedding Hulk",
        "known_for": "a downed warship where two peoples come to make promises out loud",
        "local_rule": "wear what you promised where it can be seen",
        "best_scene": "hundreds of sashes dim and brighten across one hall as promises are kept or dropped",
        "art_direction": "A cathedral-sized breached hull, rain coming through the tear, hundreds of woven sashes strung between girders and glowing pale gold, scorched deck plate below swept clean and laid with mats."
      }
    ],
    "characters": [
      {
        "name": "Reyna Odum",
        "role_drive": "hold every promise in the hulk straight in her head so nobody has to be taken at their word",
        "carries": "nothing written down, and a spare undyed sash for anyone who arrives without one",
        "complication": "she is keeping one promise she has told absolutely no one about",
        "look": "A steady, unhurried woman in a plain grey work coat, sleeves rolled, close-cropped hair going white at the temple, an undyed sash folded over one shoulder and no ornament of any kind."
      }
    ],
    "rewards": [
      {
        "name": "First-Light Sash",
        "reward_type": "ITEM",
        "rarity": "RARE",
        "grants": "shows at a glance whether the promise woven into it is still being kept",
        "best_used_when": "two people need to trust each other faster than trust normally takes",
        "catch": "it shows everyone, not only the two who made it",
        "look": "A broad woven sash holding the colours of a sunrise in its threads, gold running to rose along its length, one end frayed and rewoven in a slightly different shade."
      },
      {
        "name": "The Long Telling",
        "reward_type": "SKILL",
        "rarity": "UNCOMMON",
        "grants": "settles a quarrel by telling it back as a story both sides recognise",
        "best_used_when": "both sides are certain and neither is lying",
        "catch": "it takes all night, and everyone has to stay",
        "look": "A ring of seated listeners lit only by the sash-glow of the one speaking, that light strengthening steadily as the telling goes on."
      }
    ],
    "scenarios": [
      {
        "title": "The Sash That Went Dark",
        "setup": "In The Silk Bargain, in the middle of The Wedding Hulk, the oldest promise in the hall goes dark during a crowded evening, and Reyna Odum has until dawn to tell it back correctly before both sides decide the other broke it first."
      }
    ],
