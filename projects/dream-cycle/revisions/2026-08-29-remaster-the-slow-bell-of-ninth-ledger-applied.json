    "title": "Salvage Rights",
    "idea": "The flooded cargo decks of a lawless generation ship are full of salvage nobody has collected, because the only route out crosses water that something very large has never let anyone film.",
    "vibe": {
      "title": "Salvage Rights",
      "line": "Nobody out here pays you. You go down and take it back yourself.",
      "art_direction": "A flooded ship corridor lit by failing amber strip-lights doubled in still black water, a heavy tow cable running away into the dark, overlapping iridescent scale plating welded across a bulkhead."
    },
    "locations": [
      {
        "title": "The Ninth Deck Floodline",
        "known_for": "a flooded cargo level nobody has yet filmed all the way across",
        "local_rule": "keep one lamp pointed at the water behind you",
        "best_scene": "a camera rig comes back up with sixty seconds of nothing and one bent mounting frame",
        "art_direction": "Waist-deep black water filling a corridor of rusted cargo containers, overlapping iridescent dragon-scale plates welded crookedly over a breach, amber worklights strung low and doubling in the surface."
      }
    ],
    "characters": [
      {
        "name": "Portia Fivetooth",
        "role_drive": "tow the sunken lifeboat out of Ninth Deck before her claim on it lapses at dawn",
        "carries": "a spool of scale-plated tow cable and somebody else's borrowed camera rig",
        "complication": "she cannot hold still for more than a moment, and the water tracks movement",
        "look": "A heavyset grey-brown dugong body with a broad fluked tail and small deep-set eyes, iridescent scale plates riveted along both flanks, a cable spool strapped across her back and a lamp lashed to her snout."
      }
    ],
    "rewards": [
      {
        "name": "The Unsinkable Strongbox",
        "reward_type": "ITEM",
        "rarity": "RARE",
        "grants": "always floats upright and keeps whatever is inside it dry",
        "best_used_when": "the way out is underwater and what you are carrying is not",
        "catch": "it floats upright whether or not you are still holding it",
        "look": "A squat iron-bound chest the size of a footlocker, its wood blackened and swollen, overlapping green-gold scale plates nailed across the lid, waterline stains ringing it."
