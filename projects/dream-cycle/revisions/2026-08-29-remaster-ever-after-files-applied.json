  "proposal": {
    "title": "Third-Act Money",
    "idea": "In a city where happy endings are bought and sold as futures above the stage, a playwright who was written out of her own hit show goes back on opening night to take her ending off the actress currently wearing it.",
    "vibe": {
      "title": "Third-Act Money",
      "line": "Somebody is trading your ending on a floor you will never be shown.",
      "art_direction": "A gilded theatre seen from the flies at night, brokers hanging motionless along the rafter beams, gold thread strung between them catching the stage-light rising from below, rain on the high windows."
    },
    "locations": [
      {
        "title": "The Gilded Rafters",
        "known_for": "endings bought and sold in the beams above a working stage",
        "local_rule": "no bidding while the curtain is up",
        "best_scene": "the whole rafter goes still mid-bid because a real ending just walked in the door",
        "art_direction": "Dust-thick timber beams above a lit stage, brokers folded thin and motionless along them like branches, gold starfruit-fiber thread strung bead to bead, warm light leaking up through the boards."
      }
    ],
    "characters": [
      {
        "name": "Ottoline Sarr",
        "role_drive": "take back the ending that was cut out of her and sold on",
        "carries": "the only surviving copy of her original third act, folded into eight",
        "complication": "she has waited so long to be owed this that she no longer wants it back gently",
        "look": "A tall stick-insect woman in a soaked evening coat, limbs long and dry-brown and jointed twice too often, a narrow face lit hard from below, gold thread wound and knotted along one forearm."
      }
    ],
    "rewards": [
      {
        "name": "The Understudy's Shawl",
        "reward_type": "ITEM",
        "rarity": "RARE",
        "grants": "makes the wearer read as whoever the room was already expecting",
        "best_used_when": "you need to be somewhere your face is not welcome",
        "catch": "the room's expectation is what shows, not anything you chose",
        "look": "A loose knitted shawl of gold starfruit fiber gone soft with handling, one corner unravelling into a long loose thread, warm lamplight caught in the weave."
      },
      {
        "name": "Rewrite On Your Feet",
        "reward_type": "SKILL",
        "rarity": "UNCOMMON",
        "grants": "changes how a scene ends while it is still being played",
        "best_used_when": "the room has committed to a version of events",
        "catch": "whatever it changes, it changes for everyone who was there, permanently",
        "look": "Wet black ink blooming up through printed lines on a held page, letters sliding into new positions while the paper is still in someone's hand."
      }
    ],
