  "proposal": {
    "characters": [
      {
        "carries": "a folding brass scale, a bag of counting stones worn smooth, and the night's accounts held entirely in his head",
        "complication": "he keeps bending the terms to make the night work, and the dead are literalists",
        "look": "A broad ankylosaur in a good coat cut to fit over armoured back plates, club tail bound in ceremonial cord, a brass scale hanging from one wrist, reading lenses perched on a blunt snout.",
        "name": "Ilkay Demirci",
        "role_drive": "get the dowry agreed and the couple up the stair before dawn"
      }
    ],
    "idea": "A marriage between a mountain town and an armoured saurian clan has to be priced, witnessed and agreed in one night — and in this valley the dead have standing to object.",
    "locations": [
      {
        "art_direction": "A thousand worn stone steps rising into cold mist, drifts of glittering starlight powder banked against the risers, grey unmoving figures on either side, one warm lantern halfway up.",
        "best_scene": "the whole stair turns its head at once toward a single spoken objection",
        "known_for": "a wedding stair the dead line shoulder to shoulder from bottom to top",
        "local_rule": "never thank one of them by name",
        "title": "The Bride's Long Stair"
      }
    ],
    "rewards": [
      {
        "best_used_when": "a room is full of people who all feel wronged",
        "catch": "petty grievances are not thereby made to go away",
        "grants": "separates a real objection from a petty one",
        "look": "A shallow brass sieve worn bright at the rim, caked in glittering pale powder, its mesh sagging in the middle from long use.",
        "name": "Sieve of Small Grievances",
        "rarity": "RARE",
        "reward_type": "ITEM"
      },
      {
        "best_used_when": "the loudest person in the room is not the injured one",
        "catch": "it cannot be revoked once the floor is given",
        "grants": "gives a silent party the floor for as long as it takes",
        "look": "A cold blue seam of light opening down the middle of a stone floor and widening into a clear standing gap, dust drawn back from both its edges.",
        "name": "Standing to Object",
        "rarity": "UNCOMMON",
        "reward_type": "SKILL"
      }
    ],
    "scenarios": [
      {
        "setup": "In The Dowry of Stones, partway up The Bride's Long Stair, Ilkay Demirci hears a grey figure four steps below say a name nobody has spoken in sixty years, and has to decide whether the objection counts before the couple reaches the top.",
        "title": "The Objection on the Stair"
      }
    ],
