  "proposal": {
    "title": "The Dusk Drive",
    "idea": "On a Martian bog colony the water only goes where the unicorn-touched herd walks, and the herd only walks at dusk — so moving them across a dry basin in one night is the difference between a district that drinks and a district that does not.",
    "vibe": {
      "title": "The Dusk Drive",
      "line": "The water goes where the herd goes, and the herd goes at dusk.",
      "art_direction": "A vast rust-red basin at last light, a moving mass of pale horned animals kicking up ochre dust, standing water spreading behind them in the hoofprints, mirror-bright sluice gates on the far ridge."
    },
    "locations": [
      {
        "title": "Sump Nine",
        "known_for": "bog that only exists where the herd has walked this season",
        "local_rule": "never put yourself between the herd and the low ground",
        "best_scene": "a dry basin filling in behind ten thousand hooves in under an hour",
        "art_direction": "A terraced Martian basin of rust dust and black peat, mirror-bright adamantium sluice gates set into the slope, shallow water threading between churned hoofprints, thin cold haze under a violet sky."
      }
    ],
    "characters": [
      {
        "name": "Tobiah Ncube",
        "role_drive": "walk the herd across the dry basin in a single dusk",
        "carries": "a splice-cable he plugs into his own jaw to hear what the herd hears",
        "complication": "the herd's signal is louder than his own thoughts, and he has stopped minding",
        "look": "A calm, heavy-set man in a dust-caked drover's coat, a chrome splice port set into his jawline trailing a coiled cable, one eye replaced with a matte lens, pale horn-scar curling up his forearm."
      }
    ],
    "rewards": [
      {
        "name": "The Borrowed Grin",
        "reward_type": "ITEM",
        "rarity": "RARE",
        "grants": "makes strangers trust the wearer the way they trusted its last owner",
        "best_used_when": "there is no time to earn it honestly",
        "catch": "its last owner died being trusted",
        "look": "A mirror-bright adamantium jaw plate shaped to a wide easy smile, a hairline crack running through two of the teeth, worn warm on the inside."
      },
      {
        "name": "Old-Protocol Whisper",
        "reward_type": "SKILL",
        "rarity": "UNCOMMON",
        "grants": "makes obsolete machinery answer as though its original crew were still aboard",
        "best_used_when": "the only thing still standing was built two centuries ago",
        "catch": "it answers in the voice of whoever used it last",
        "look": "Amber legacy glyphs waking one panel after another down a dark corridor, each dying back as the next lights."
      }
    ],
    "scenarios": [
      {
        "title": "The Night Shift Reroute",
        "setup": "In The Dusk Drive, out on Sump Nine, Tobiah Ncube has the herd halfway across the dry basin when the smelter district's shift boss starts closing gates ahead of him, one at a time, to turn the water somewhere it will be worth more."
      }
    ],
