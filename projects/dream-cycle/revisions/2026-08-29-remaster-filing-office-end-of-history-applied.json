  "proposal": {
    "title": "The Hundredth Procession",
    "idea": "A treaty holds only as long as its procession is walked exactly as it has always been walked, and this year the machine that remembers every previous year is showing one of them turning the wrong way.",
    "vibe": {
      "title": "The Hundredth Procession",
      "line": "Walk it exactly as it has always been walked, or the year does not take.",
      "art_direction": "A carnival street at night lined with ore-lit mirrors, one bright procession walking it while dozens of translucent earlier processions overlap them in the glass, blue ore light and streamers overhead."
    },
    "locations": [
      {
        "title": "The Repeating Mile",
        "known_for": "a ceremonial street that shows you every year it has ever been walked",
        "local_rule": "step where your predecessors stepped",
        "best_scene": "a hundred processions walk the mile at once and exactly one of them turns the wrong way",
        "art_direction": "A narrow festival street walled in tall mirrors veined with blue glowing ore, layered translucent crowds receding into the glass, paper streamers and lamp strings above wet cobbles."
      }
    ],
    "characters": [
      {
        "name": "Absalom Duretti",
        "role_drive": "get to the end of the mile without breaking a ceremony nobody ever taught him",
        "carries": "a borrowed sash of office and a carnival ticket stub he keeps checking",
        "complication": "he was mistaken for the ambassador an hour ago and has been too charming to correct anyone",
        "look": "A large, placid capybara upright in an oversized brocade coat, sash slipping off one round shoulder, whiskers lit blue by the mirrors, an expression of complete and unearned confidence."
      }
    ],
    "rewards": [
      {
        "name": "The Enormous Ceremonial Key",
        "reward_type": "ITEM",
        "rarity": "RARE",
        "grants": "opens whatever a watching crowd agrees it ought to open",
        "best_used_when": "the crowd is more certain than you are",
        "catch": "it takes two people to lift and neither can put it down first",
        "look": "A two-metre key of blue-glowing astral ore with a bow the size of a cartwheel, tasselled cords knotted along its shaft, its teeth worn round with handling."
      },
      {
        "name": "Confident Nonsense",
        "reward_type": "SKILL",
        "rarity": "UNCOMMON",
        "grants": "carries an outsider through a ritual they were never taught",
        "best_used_when": "everyone else knows what happens next and you do not",
        "catch": "it works right up until somebody asks a direct question",
        "look": "Hard black-and-white shadow bars sweeping across a figure who keeps walking at exactly the same unbothered pace."
      }
    ],
    "scenarios": [
      {
        "title": "The Year the Mile Disagreed",
        "setup": "In The Hundredth Procession, halfway down The Repeating Mile, Absalom Duretti sees one of the reflected processions turn left where every other year turned right, and has to decide which of the hundred versions the treaty is actually counting."
      }
