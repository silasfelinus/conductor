  "proposal": {
    "title": "Rulewriter's Season",
    "idea": "For ninety nights a year the cliffs light from inside, and whoever writes that season's rules decides who may glide the high pasture — a job everyone wants until the mountain starts enforcing the rules exactly as written.",
    "vibe": {
      "title": "Rulewriter's Season",
      "line": "Somebody writes the rules each year, and the mountain enforces them to the letter.",
      "art_direction": "A vast cliff face lit from within by veins of pale green glowstone at dusk, dozens of small gliding figures launching from ledges, long banners of hand-lettered rules snapping in the updraft."
    },
    "locations": [
      {
        "title": "The Glowstone Shelf",
        "known_for": "cliffs that light from the inside for ninety nights a year",
        "local_rule": "no glide begins before the third stone kindles",
        "best_scene": "the last stone lights and a hundred gliders leave the ledge in one breath",
        "art_direction": "A wide stone shelf over a green-lit gorge, glowstone veins pulsing under the rock like lit wiring, chalked rule-boards leaning along the wall, updraft carrying loose paper into the dark."
      }
    ],
    "characters": [
      {
        "name": "Oriel Tanaka",
        "role_drive": "write a season of rules nobody can twist, and be admired for it",
        "carries": "a chalk-stick and the rule-board she refuses to let anyone else letter",
        "complication": "she is certain her wording is perfect, and the mountain has begun proving otherwise",
        "look": "A small sugar-glider woman in a wind-scuffed flight wrap, patagial membrane stretched between wrist and ankle and chalk-dusted along its edge, huge dark eyes, chin up, ink stains at both cuffs."
      }
    ],
    "rewards": [
      {
        "name": "The Second-Chance Stone",
        "reward_type": "ITEM",
        "rarity": "RARE",
        "grants": "gives back the ten seconds you have just spent",
        "best_used_when": "you have already committed to the wrong line",
        "catch": "everyone else remembers the ten seconds you took back",
        "look": "A thumb-sized shard of green glowstone in a bent wire cage, its light guttering and recovering in a slow ten-count, warm as a held coal."
      },
      {
        "name": "Clause Craft",
        "reward_type": "SKILL",
        "rarity": "UNCOMMON",
        "grants": "writes one new rule into the season and makes the valley keep it",
        "best_used_when": "the existing wording is being obeyed and abused at once",
        "catch": "the valley keeps it exactly as written, forever",
        "look": "Letters scorching themselves pale gold into standing grass in a wide sweeping arc, thin smoke rising from each stroke as it finishes."
      }
    ],
    "scenarios": [
      {
        "title": "The Night the Rules Changed Mid-Air",
        "setup": "In Rulewriter's Season, off The Glowstone Shelf with a hundred gliders already in the air, Oriel Tanaka realises her own wording lets the leading team win by never landing, and has to letter a new clause before they cross the pasture line."
      }
    ],
