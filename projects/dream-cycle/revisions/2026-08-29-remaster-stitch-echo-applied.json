  "proposal": {
    "title": "The Bridge From Next Century",
    "idea": "A nanotech engineer pulled out of her own world wakes as the boiler-imp's apprentice in a mountain bathhouse, and the town's bridge — built in a century that has not happened yet — has started coming apart.",
    "vibe": {
      "title": "The Bridge From Next Century",
      "line": "Everything useful here was built by someone who has not arrived yet.",
      "art_direction": "A steaming wooden bathhouse under snow at night, pale blue mineral light leaking from its boiler vents, and beyond it a slender bridge of impossibly thin material glowing faintly across a black gorge."
    },
    "locations": [
      {
        "title": "The Moonstone Bathhouse",
        "known_for": "a boiler nobody in this century knows how to have built",
        "local_rule": "feed the boiler before you feed yourself",
        "best_scene": "the boiler door opens and the light inside is the wrong colour for fire",
        "art_direction": "A cramped wooden boiler room thick with steam, brass valves furred with mineral scale, a small horned figure silhouetted against a cold blue-white glow that throws no heat shimmer."
      }
    ],
    "characters": [
      {
        "name": "Rina Oyelaran",
        "role_drive": "keep the bridge standing long enough to understand what built it",
        "carries": "a cracked lab slate and a vial of dormant repair-motes she rations by the grain",
        "complication": "she keeps stopping mid-repair to ask what the bridge is for, and the imp keeps not answering",
        "look": "A tired engineer in a borrowed cotton work robe over lab trousers, soot to the elbow, twists of hair tied back with wire, a cracked slate tucked under one arm."
      }
    ],
    "rewards": [
      {
        "name": "The Patient Seed",
        "reward_type": "ITEM",
        "rarity": "RARE",
        "grants": "repairs one thing slowly and completely",
        "best_used_when": "a bad fast fix would hold just long enough to kill someone",
        "catch": "slowly means seasons, and it cannot be hurried",
        "look": "A single moonstone bead the size of a pea, milk-pale with a drifting blue sheen, warm to the touch and faintly gritty, kept in a folded paper packet."
      },
      {
        "name": "Ask the Small Things",
        "reward_type": "SKILL",
        "rarity": "UNCOMMON",
        "grants": "persuades a machine's smallest parts to hold a little longer",
        "best_used_when": "the whole structure is going and you only need a minute",
        "catch": "whatever holds longer now gives way harder later",
        "look": "A haze of silver motes settling into a hairline crack and glowing steadily along its whole length like a filament."
      }
    ],
    "scenarios": [
      {
        "title": "The Night the Bridge Asked for Help",
        "setup": "In The Bridge From Next Century, out from The Moonstone Bathhouse in a snowstorm, Rina Oyelaran is halfway across the failing span when its surface writes a request under her feet in her own handwriting, in a notation she has not invented yet."
      }
    ],
