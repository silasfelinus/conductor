  "proposal": {
    "title": "The Deep Shift",
    "idea": "A grounded starship pilot takes the worst job on a sea-otter kelp rig — the deep shift, alone under the canopy — and finds that the thing the crew will not discuss is already waiting at the bottom of her first descent.",
    "vibe": {
      "title": "The Deep Shift",
      "line": "Everyone here is very calm about what happens on the night shift.",
      "art_direction": "A cramped underwater work rig lit by yellow deck lamps, dense kelp stems rising past its windows into black water, a single diver's lamp far below in the murk, frost creeping across the inside of the glass."
    },
    "locations": [
      {
        "title": "Kelphold Rig",
        "known_for": "harvesting a kelp canopy nobody is allowed to go under alone, except on the deep shift",
        "local_rule": "come up when the lamps go amber, whatever you are holding",
        "best_scene": "every lamp on the rig goes amber at once and nobody moves toward the ladder",
        "art_direction": "A squat riveted underwater rig furred with growth, yellow lamps in cages, harvest cradles heaped with dripping kelp, cold ice-blue light filtering down through a canopy far overhead."
      }
    ],
    "characters": [
      {
        "name": "Imogen Halvard",
        "role_drive": "work the deep shift long enough to buy back her flight certification",
        "carries": "a grounded pilot's helmet she still wears underwater because it is hers",
        "complication": "she keeps proposing better ways to run the rig, and the crew keeps quietly not explaining why they don't",
        "look": "A rangy woman in a patched dive suit two decades out of date, scarred flight helmet under her arm, salt-bleached hair, forearms corded from hauling, a burn scar across one cheek."
      }
    ],
    "rewards": [
      {
        "name": "Coldwater Bell",
        "reward_type": "ITEM",
        "rarity": "RARE",
        "grants": "rings once, everywhere, when something below has noticed you",
        "best_used_when": "the water has gone quiet in a way that feels deliberate",
        "catch": "it also tells the thing below exactly where the bell is",
        "look": "A small hand-bell cast from cloudy blue ice-metal, rimed white at the lip, its clapper hanging perfectly still even when the water moves."
      },
      {
        "name": "Dead-Reckoning Descent",
        "reward_type": "SKILL",
        "rarity": "UNCOMMON",
        "grants": "holds a true course down through water with no light and no landmarks",
        "best_used_when": "every instrument on you has gone useless",
        "catch": "it gets you down accurately, and says nothing about getting back",
        "look": "A single lamp-beam falling in a perfectly straight line through churning dark water, silt and bubbles crossing it without bending it."
      }
    ],
