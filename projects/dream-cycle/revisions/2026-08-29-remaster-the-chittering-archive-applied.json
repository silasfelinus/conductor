  "proposal": {
    "title": "Monsoon Static",
    "slug": "the-chittering-archive",
    "idea": "When the storm season floods a mythpunk megacity, its rooftop crews keep the flood barriers powered by performing — verses shouted into hand-woven silk cable become current, and the block that goes quiet is the block the water takes.",
    "vibe": {
      "title": "Monsoon Static",
      "line": "The storm only spares the block that out-sings it.",
      "art_direction": "Rain-lashed corrugated rooftops strung with hand-woven radiant-silk power line glowing amber, a jury-rigged broadcast mast wrapped in patterned indigo cloth, black floodwater below throwing back sodium orange light and drifting foam."
    },
    "locations": [
      {
        "title": "The Roofline Circuit",
        "known_for": "rooftop stages wired straight into the flood barriers",
        "local_rule": "the loudest verse gets the power",
        "best_scene": "the surge climbs the stairwell while the mast crew hauls glowing silk line back up hand over hand",
        "art_direction": "A chain of tin and concrete rooftops joined by sagging luminous silk cable, sandbagged stage platforms lashed with rope, small chinchilla-borne relay drones perched along the wires, green-black stormlight and horizontal rain."
      }
    ],
    "characters": [
      {
        "name": "Adaeze Bankole",
        "role_drive": "hold the roofline stage all night so the barrier lamps never drop",
        "carries": "a battered throat-mic rig spliced into a chinchilla-carried relay pack",
        "complication": "her voice is failing, and every verse she spends costs her the next one",
        "look": "A warm, broad-shouldered performer in a soaked indigo wax-print jacket, a copper throat-mic collar biting into her neck, wet braids taped flat, one forearm sleeved in cracked cyber-plating that glows faintly at the seams."
      }
    ],
    "rewards": [
      {
        "name": "Stormsong Reed",
        "reward_type": "ITEM",
        "rarity": "RARE",
        "grants": "gives a spent voice one more full verse",
        "best_used_when": "the crowd has gone quiet and the barrier lamps are dimming",
        "catch": "the borrowed verse is the last thing its previous owner ever said",
        "look": "A hand-length reed of woven radiant silk stiffened with amber resin, its mouthpiece worn glassy, a single gold thread pulsing along its length."
      },
      {
        "name": "Call-and-Return",
        "reward_type": "SKILL",
        "rarity": "UNCOMMON",
        "grants": "turns a crowd's answering shout back into usable current",
        "best_used_when": "the cable has gone dark between verses",
        "catch": "the crowd feels every jolt she draws through them",
        "look": "Amber sound-rings blooming outward from an open mouth and snapping back as bright filaments that crawl along the wet silk cable overhead."
      }
    ],
    "scenarios": [
      {
        "title": "The Surge Set",
        "setup": "In Monsoon Static, up on The Roofline Circuit, Adaeze Bankole trades verses with a rival crew across the flooded bog district through the night's highest surge while chinchilla relay drones drag the silk line back onto the mast — because the moment the roofline goes quiet, the barrier lamps die and the water takes the block."
      }
