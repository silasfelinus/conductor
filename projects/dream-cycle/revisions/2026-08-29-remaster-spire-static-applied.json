  "proposal": {
    "title": "Lullaby Run",
    "idea": "A coastal town's whole economy is keeping one enormous sleeping thing asleep, and the crop-duster pilot who flies sleep-spore between its ribs every dusk has just been told the mainland wants it awake.",
    "vibe": {
      "title": "Lullaby Run",
      "line": "The whole town's work is keeping one enormous thing asleep.",
      "art_direction": "A small propeller plane threading between colossal barnacled ribs that arch out of a calm bay, violet crystal furring the bone, dusk light and a long trail of pale spore drifting behind the wing."
    },
    "locations": [
      {
        "title": "The Ribbed Sound",
        "known_for": "a bay roofed by the ribs of something still breathing",
        "local_rule": "engines off between the third and fourth rib",
        "best_scene": "the ribs flex a handspan and every boat in the bay lifts at once",
        "art_direction": "Vast curved bone arches rising from flat green water, violet crystal growth crusting their undersides, fishing boats tied up small beneath them, low amber light and mist on the surface."
      }
    ],
    "characters": [
      {
        "name": "Maret Solvang",
        "role_drive": "fly the dusk spore run without waking what she is dusting",
        "carries": "a canvas satchel of townsfolk's letters she reads aloud over the open radio each run",
        "complication": "she narrates every worry out loud, and the radio carries all of it to the town below",
        "look": "A lean sharkfolk pilot in a cracked leather flight jacket, slate-grey skin, gill lines dark along her throat, goggles pushed up on a smooth crown, one webbed hand taped at the knuckles."
      }
    ],
    "rewards": [
      {
        "name": "Hushspore Canister",
        "reward_type": "ITEM",
        "rarity": "RARE",
        "grants": "releases one dose of sleep-spore across a wide area",
        "best_used_when": "something very large has begun to stir",
        "catch": "everything under the cloud sleeps, including whoever dropped it",
        "look": "A dented copper canister the length of a forearm, its little glass window furred with pale violet crystal, a rope handle bound around with faded red thread."
      },
      {
        "name": "Breath Timing",
        "reward_type": "SKILL",
        "rarity": "UNCOMMON",
        "grants": "matches a run to the rhythm of something enormous breathing",
        "best_used_when": "the gap you need opens and closes on its own schedule",
        "catch": "she feels the next breath coming in her own chest, awake or not",
        "look": "A long white contrail bending in slow unison with a vast rising surface, spray rolling outward from it in a widening ring."
      }
    ],
    "scenarios": [
      {
        "title": "The Night They Cut the Spore Line",
        "setup": "In Lullaby Run, out over The Ribbed Sound, Maret Solvang finds the dusk supply barge gone and mainland launches anchored where it should be, and has to decide on the radio, in front of the whole listening town, whether to fly the run empty or land."
      }
    ],
