        "known_for": "Its tents rise directly over active fault lines, timing every act to the gaps between tremors.",
        "local_rule": "No show starts until the ground stops humming.",
        "title": "The Suture Circus"
      }
    ],
    "rewards": [
      {
        "best_used_when": "A tremor spooks the herd right before showtime.",
        "catch": "Overuse hardens the prod's tip into inert dragon scale, and the speaker garbles into silence for good.",
