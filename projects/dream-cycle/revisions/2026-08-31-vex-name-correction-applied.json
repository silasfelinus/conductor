  "proposal": {
    "characters": [
      {
        "carries": "She carries a coil of dragon-scale rope worn smooth at the grip.",
        "complication": "Her herd is bred from the last wild cactus line, and every hardened prod she uses risks becoming their apocalypse.",
        "look": "a squat, charismatic goblin in a patched leather vest studded with cactus spines, dragon-scale rope coiled over one shoulder, dust-caked boots, a gap-toothed grin",
        "name": "Oleta Kanu",
        "role_drive": "She has to hold her cactus herd steady through every tremor, because a spooked herd ends the show."
      }
    ],
    "idea": "A traveling circus stakes its big top directly over active fault lines, timing its bioengineered-cactus acts to the tectonic plates' slow, romantic collisions -- until a goblin wrangler feels the courtship reach its final beat mid-show.",
    "locations": [
      {
        "art_direction": "A patchwork canvas big top staked into cracked red earth, guy-ropes strung with strands of iridescent dragon scale that hum and flex with each tremor, striped fabric lit gold from lanterns inside.",
