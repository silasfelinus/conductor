  "proposal": {
    "title": "Bloomline",
    "idea": "On a generation ship whose air is grown rather than pumped, a flower nobody planted has begun opening in a line across the farm decks — and the line traces exactly where a missing crewmate walked on the night she vanished.",
    "vibe": {
      "title": "Bloomline",
      "line": "Something is planting evidence in the air we breathe.",
      "art_direction": "A curved agricultural deck lit by grown crystal instead of lamps, one narrow line of white flowers opening across otherwise green rows, pale violet light raking low between the planting beds."
    },
    "locations": [
      {
        "title": "Greenhold",
        "known_for": "a farm deck lit by grown crystal instead of lamps",
        "local_rule": "nobody prunes what they did not plant",
        "best_scene": "an entire row flowers at once, tracing a person's path from door to hull wall",
        "art_direction": "Long curving planting beds under a ceiling of clustered violet crystal, wet black soil, condensation beading on cold metal ribs, one line of white blossoms cutting across the green."
      }
    ],
    "characters": [
      {
        "name": "Yusra Panek",
        "role_drive": "find out who the flowers are following before the line reaches the nursery deck",
        "carries": "a pocketful of seed envelopes she keeps refilling and never plants",
        "complication": "she is relentlessly cheerful, and the crew has stopped believing anything she says",
        "look": "A stocky goblin in patched solar-weave coveralls, green skin dusted yellow with pollen, wide flat nose, magnifying spectacles pushed up into wiry grey hair, soil worked deep into her knuckles."
      }
    ],
    "rewards": [
      {
        "name": "The Overture Fork",
        "reward_type": "ITEM",
        "rarity": "RARE",
        "grants": "hums when it passes air the wrong plant has breathed",
        "best_used_when": "a room smells ordinary and should not",
        "catch": "it hums for the plant, never for the person who carried it",
        "look": "A wind-up tuning fork of brass and clouded crystal, its winding key worn smooth, a hairline fracture running up one tine and catching the light."
      },
      {
        "name": "The Long Pause",
        "reward_type": "SKILL",
        "rarity": "UNCOMMON",
        "grants": "holds a silence until the other person fills it with something true",
        "best_used_when": "an answer arrives too quickly and too complete",
        "catch": "it works just as well on whoever is holding the silence",
        "look": "Air gone visibly still between two figures, dust hanging motionless in a shaft of violet light, one lamp guttering low and steadying again."
      }
    ],
    "scenarios": [
      {
        "title": "What Flowered on Deck Nine",
        "setup": "In Bloomline, down in Greenhold, Yusra Panek follows the opening flowers from the missing woman's bunk to a hull seam nobody has cracked in forty years, and finds the next bloom already unfolding on the inside of her own wrist."
      }
    ],
