{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/silasfelinus/conductor/blob/main/projects/shifting-desks/encounters/ENCOUNTER-PACK.schema.json",
  "title": "Shifting Desks authored encounter pack v1",
  "description": "Fork of Zuzu: Shifting Lands encounter pack v1 for an office-dystopia game: five meters instead of HP/provisions, an up-front cost per choice, optional roll (sacrifices can be certain), requires gates, tags, callback notes and a boss review card per department. validate_pack.py is the CI authority and adds cross-field rules (no clean wins, flag reachability, outcome reachability).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project",
    "status",
    "department",
    "rules",
    "locations",
    "encounters",
    "boss"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "project": {
      "const": "shifting-desks"
    },
    "status": {
      "const": "draft-not-imported"
    },
    "department": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "order",
        "boss_id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "title": {
          "type": "string",
          "minLength": 3
        },
        "order": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "boss_id": {
          "$ref": "#/$defs/slug"
        }
      }
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "encounters_per_location_min",
        "selection",
        "seed_persisted",
        "revisit_policy",
        "dice",
        "no_clean_wins"
      ],
      "properties": {
        "encounters_per_location_min": {
          "type": "integer",
          "minimum": 2
        },
        "selection": {
          "const": "seeded-weighted-eligible-without-replacement"
        },
        "seed_persisted": {
          "const": true
        },
        "revisit_policy": {
          "const": "same-recorded-encounter-no-free-reroll"
        },
        "dice": {
          "const": "2d6+skill+modifier-vs-target"
        },
        "no_clean_wins": {
          "const": true
        }
      }
    },
    "locations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "location_id",
          "title",
          "description",
          "encounter_ids"
        ],
        "properties": {
          "location_id": {
            "$ref": "#/$defs/slug"
          },
          "title": {
            "type": "string",
            "minLength": 3
          },
          "description": {
            "type": "string",
            "minLength": 20
          },
          "encounter_ids": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/slug"
            }
          }
        }
      }
    },
    "encounters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/encounter"
      }
    },
    "boss": {
      "$ref": "#/$defs/boss"
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "composure": {
          "type": "integer",
          "minimum": -3,
          "maximum": 3,
          "not": {
            "const": 0
          }
        },
        "clearance": {
          "type": "integer",
          "minimum": -3,
          "maximum": 3,
          "not": {
            "const": 0
          }
        },
        "suspicion": {
          "type": "integer",
          "minimum": -3,
          "maximum": 3,
          "not": {
            "const": 0
          }
        },
        "successors": {
          "type": "integer",
          "minimum": -3,
          "maximum": 3,
          "not": {
            "const": 0
          }
        },
        "forms": {
          "type": "integer",
          "minimum": -3,
          "maximum": 3,
          "not": {
            "const": 0
          }
        }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "effects",
        "add_flags",
        "remove_flags",
        "map_effect"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 40,
          "maxLength": 500
        },
        "effects": {
          "$ref": "#/$defs/effects"
        },
        "add_flags": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/slug"
          }
        },
        "remove_flags": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/slug"
          }
        },
        "map_effect": {
          "type": "string",
          "minLength": 4
        },
        "department_outcome": {
          "$ref": "#/$defs/slug",
          "description": "Boss routes only: the department outcome this result leads to."
        }
      }
    },
    "roll": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "dice_count",
        "die_sides",
        "skill",
        "modifier",
        "target"
      ],
      "properties": {
        "dice_count": {
          "const": 2
        },
        "die_sides": {
          "const": 6
        },
        "skill": {
          "enum": [
            "compliance",
            "initiative",
            "discretion",
            "rapport",
            "tinkering",
            "vigilance"
          ]
        },
        "modifier": {
          "type": "integer"
        },
        "target": {
          "enum": [
            7,
            9,
            11
          ]
        }
      }
    },
    "choice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "intent",
        "risk_hint",
        "requires",
        "cost",
        "roll",
        "success",
        "failure"
      ],
      "description": "validate_pack.py additionally enforces: failure is an outcome iff roll is non-null, and cost+success contains at least one harmful effect (no clean wins).",
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "label": {
          "type": "string",
          "minLength": 3,
          "maxLength": 60
        },
        "intent": {
          "type": "string",
          "minLength": 10
        },
        "risk_hint": {
          "type": "string",
          "minLength": 10
        },
        "requires": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "clearance": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "flag": {
              "$ref": "#/$defs/slug"
            },
            "forms": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "cost": {
          "$ref": "#/$defs/effects"
        },
        "roll": {
          "$ref": "#/$defs/roll"
        },
        "success": {
          "$ref": "#/$defs/outcome"
        },
        "failure": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/outcome"
            }
          ]
        }
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "kind",
        "role",
        "visual_description"
      ],
      "properties": {
        "identity": {
          "$ref": "#/$defs/slug"
        },
        "kind": {
          "type": "string",
          "minLength": 3
        },
        "role": {
          "type": "string",
          "minLength": 3
        },
        "visual_description": {
          "type": "string",
          "minLength": 20
        }
      }
    },
    "art": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "art_ref",
        "brief",
        "cast"
      ],
      "properties": {
        "status": {
          "enum": [
            "design-only",
            "verified-repository-art",
            "approved-ArtImage"
          ]
        },
        "art_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "brief": {
          "type": "string",
          "minLength": 50,
          "description": "Positive-only prompt (Kind Robots art-prompt contract), ending with 'every surface bare and unmarked'."
        },
        "cast": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/actor"
          }
        }
      }
    },
    "encounter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "location_id",
        "title",
        "flavor_text",
        "polarity",
        "tags",
        "weight",
        "unique_per_run",
        "first_visit_only",
        "witnessed",
        "callback",
        "art",
        "choices",
        "developer_note"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "location_id": {
          "$ref": "#/$defs/slug"
        },
        "title": {
          "type": "string",
          "minLength": 5,
          "maxLength": 64
        },
        "flavor_text": {
          "type": "string",
          "minLength": 90,
          "maxLength": 700
        },
        "polarity": {
          "enum": [
            "good",
            "bad",
            "mixed"
          ]
        },
        "tags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "satire",
              "psych-test",
              "deathtrap",
              "creature",
              "conspiracy",
              "toy",
              "mutant",
              "callback",
              "sacrifice"
            ]
          }
        },
        "weight": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9
        },
        "unique_per_run": {
          "const": true
        },
        "first_visit_only": {
          "const": true
        },
        "witnessed": {
          "type": "boolean",
          "description": "Using a Mutation card on a witnessed card costs +2 Suspicion."
        },
        "callback": {
          "type": [
            "string",
            "null"
          ],
          "description": "Short note naming the classic work this card alludes to; homage only, never quotation."
        },
        "art": {
          "$ref": "#/$defs/art"
        },
        "choices": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/choice"
          }
        },
        "developer_note": {
          "type": "string",
          "minLength": 20
        }
      }
    },
    "boss": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "flavor_text",
        "art",
        "choices",
        "department_outcomes",
        "developer_note"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "title": {
          "type": "string",
          "minLength": 5,
          "maxLength": 64
        },
        "flavor_text": {
          "type": "string",
          "minLength": 90,
          "maxLength": 700
        },
        "art": {
          "$ref": "#/$defs/art"
        },
        "choices": {
          "type": "array",
          "minItems": 3,
          "items": {
            "$ref": "#/$defs/choice"
          }
        },
        "department_outcomes": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "title",
              "summary"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/slug"
              },
              "title": {
                "type": "string",
                "minLength": 3
              },
              "summary": {
                "type": "string",
                "minLength": 20
              }
            }
          }
        },
        "developer_note": {
          "type": "string",
          "minLength": 20
        }
      }
    }
  }
}
