<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/superkate_splash_background" />
    <item android:gravity="center">
        <shape android:shape="rectangle">
            <size
                android:width="104dp"
                android:height="104dp" />
            <corners android:radius="32dp" />
            <gradient
                android:angle="45"
                android:centerColor="@color/superkate_splash_violet"
                android:endColor="@color/superkate_splash_secondary"
                android:startColor="@color/superkate_splash_primary" />
        </shape>
    </item>
</layer-list>
